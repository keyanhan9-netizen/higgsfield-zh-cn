{
  "manifest_version": 3,
  "name": "Higgsfield 简体中文（非官方）",
  "version": "0.2.0",
  "description": "本地词典汉化 Higgsfield 导航及已验证界面控件，支持中英文切换。非官方、无关联、无遥测。",
  "minimum_chrome_version": "102",
  "permissions": ["storage"],
  "action": {
    "default_title": "Higgsfield 汉化 · 非官方",
    "default_popup": "popup.html"
  },
  "content_scripts": [{
    "matches": ["https://higgsfield.ai/*", "https://www.higgsfield.ai/*"],
    "js": ["dictionary.js", "engine.js", "content.js"],
    "run_at": "document_idle",
    "all_frames": false,
    "world": "ISOLATED"
  }],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  }
}
